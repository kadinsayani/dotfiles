# ~/.bashrc: executed by bash(1) for non-login shells.

# If not running interactively, don't do anything
case $- in
*i*) ;;
*) return ;;
esac

# ---------------------------------------------------------------- shell options

shopt -s histappend  # append to the history file, don't overwrite it
shopt -s checkwinsize # keep LINES/COLUMNS correct after each command

HISTCONTROL=ignoreboth
HISTSIZE=50000
HISTFILESIZE=100000
HISTTIMEFORMAT='%F %T '

# make less more friendly for non-text input files, see lesspipe(1)
[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

# ---------------------------------------------------------------- PATH

# Prepend to PATH only if not already present, so re-sourcing this file
# does not keep growing PATH.
path_prepend() {
	case ":$PATH:" in
	*":$1:"*) ;;
	*) [ -d "$1" ] && PATH="$1:$PATH" ;;
	esac
}

export GOPATH="$HOME/go"

path_prepend "$GOPATH/bin"
path_prepend "$HOME/.cargo/bin"
path_prepend "$HOME/.opencode/bin"
path_prepend "$HOME/.local/bin"

# node/npm and the copilot + codex CLIs live in the nvm-managed node, so this
# has to be on PATH before nvm itself is loaded (see "tool init" below).
# Globs sort lexically: fine for v24/v25, would mis-order v9 vs v10.
_nvm_bins=("$HOME/.nvm/versions/node"/*/bin)
if [ -d "${_nvm_bins[-1]}" ]; then
	path_prepend "${_nvm_bins[-1]}"
fi
unset _nvm_bins

export PATH

# ---------------------------------------------------------------- environment

export EDITOR=nvim
export VISUAL=$EDITOR

# LXD / dqlite build environment
export LXD_SHIFTFS_DISABLE=true
export CGO_CFLAGS="-I${GOPATH}/deps/dqlite/include/"
export CGO_LDFLAGS="-L${GOPATH}/deps/dqlite/.libs/"
export LD_RUN_PATH="${GOPATH}/deps/dqlite/.libs/"
export CGO_LDFLAGS_ALLOW="(-Wl,-wrap,pthread_create)|(-Wl,-z,now)"

export MICROCLOUD_DEBUG_PATH=~/go/bin/microcloud
export MICROCLOUDD_DEBUG_PATH=~/go/bin/microcloudd

# ---------------------------------------------------------------- aliases

# general
if [ -x /usr/bin/dircolors ]; then
	test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
	alias ls='ls --color=auto'
	alias grep='grep --color=auto'
	alias fgrep='fgrep --color=auto'
	alias egrep='egrep --color=auto'
fi
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
alias vi='nvim'
alias lg='lazygit'

# Use like so:  sleep 10; alert
alias alert='notify-send --urgency=low -i "$([ $? = 0 ] && echo terminal || echo error)" "$(history|tail -n1|sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'

# git
alias gcapache='git commit --amend -s --trailer License:Apache-2.0'
alias forcepush='git push --force-with-lease'

# LXD
# NOTE: deliberately not named `lxd` — that would shadow the real binary.
alias lxdrun='sudo --preserve-env=PATH,GORACE,LXD_SHIFTFS_DISABLE $GOPATH/bin/lxd'
alias lxdstart='sudo --preserve-env=PATH,GORACE,LXD_SHIFTFS_DISABLE $GOPATH/bin/lxd --group sudo -v -d'
alias lxdtest='cd ~/git/lxd/test && sudo --preserve-env=PATH,GOPATH,GORACE,LXD_INSPECT,LXD_DEBUG,LXD_VERBOSE,LXD_BACKEND,LXD_NIC_BRIDGED_DRIVER,LXD_CEPH_CLUSTER,LXD_CEPH_CEPHOBJECT_RADOSGW,LXD_CONCURRENT,LXD_SKIP_TESTS,LXD_REQUIRED_TESTS,LXD_SHIFTFS_DISABLE LXD_TMPFS=1 LXD_VERBOSE=1 LXD_NIC_SRIOV_PARENT= LXD_TEST_IMAGE= ./main.sh'
alias lxdgotest='sudo --preserve-env=GOPATH,CGO_CFLAGS,CGO_LDFLAGS_ALLOW,CGO_LDFLAGS,LD_RUN_PATH,PATH go test ./...'
alias lxddebug='sudo --preserve-env=PATH,CGO_LDFLAGS,CGO_CFLAGS,GORACE,LXD_DIR,LXD_UI LD_LIBRARY_PATH=${LD_LIBRARY_PATH} $GOPATH/bin/dlv --listen=:2345 --headless=true --api-version=2 --accept-multiclient exec $GOPATH/bin/lxd -- --group sudo -v -d' # compile with -gcflags="all=-N -l"
alias makedebug='make DEBUG="-gcflags=\"all=-N -l\""'
alias debug='makedebug && lxddebug'
alias makestart='make && lxdstart'
alias cdlxd='cd ~/git/lxd'
alias complxc='. <(lxc completion bash)'
alias initlxd='lxd init --auto && lxc alias add sh "exec @ARGS@ -- su -l --whitelist-environment EDITOR" && lxc profile set default environment.EDITOR vi'

# work scripts
alias testbox='~/git/utils/scripts/testbox.sh'
alias sideload='~/git/utils/scripts/sideload.sh'
alias beam='~/git/utils/scripts/beam.sh'

# zellij
alias z='zellij'
alias znew='z -s dev -n ~/.config/zellij/dev.kdl'
alias zup='z attach dev'

# ---------------------------------------------------------------- functions

# Was an alias, which silently dropped its arguments — aliases have no $1.
lx() {
	lxc exec "$1" -- "${@:2}"
}

lxt() {
	lxc config device set lxdtest lxd-git source="$(pwd)"
	sleep 3
	lxc exec lxdtest -- bash -c "cd lxd && make && make test-shell"
}

mkcd() {
	\mkdir -p "$1"
	cd "$1" || return
}

tempe() {
	cd "$(mktemp -d)" || return
	chmod -R 0700 .
	if [[ $# -eq 1 ]]; then
		\mkdir -p "$1"
		cd "$1" || return
		chmod -R 0700 .
	fi
}

# ---------------------------------------------------------------- tool init

if [ -f ~/.bash_aliases ]; then
	. ~/.bash_aliases
fi

if ! shopt -oq posix; then
	if [ -f /usr/share/bash-completion/bash_completion ]; then
		. /usr/share/bash-completion/bash_completion
	elif [ -f /etc/bash_completion ]; then
		. /etc/bash_completion
	fi
fi

eval "$(just --completions bash)"

# `gh copilot alias` costs ~77ms; it only ever emits the ghcs/ghce functions,
# so cache it. Delete the cache file to regenerate after a gh upgrade.
_gh_copilot_cache="$HOME/.cache/gh-copilot-alias.bash"
if [ ! -s "$_gh_copilot_cache" ] && command -v gh >/dev/null 2>&1; then
	mkdir -p "$(dirname "$_gh_copilot_cache")"
	gh copilot alias -- bash >"$_gh_copilot_cache" 2>/dev/null
fi
[ -s "$_gh_copilot_cache" ] && . "$_gh_copilot_cache"
unset _gh_copilot_cache

# opencode shell completions (generated by `opencode completion`)
###-begin-opencode-completions-###
#
# yargs command completion script
#
# Installation: opencode completion >> ~/.bashrc
#    or opencode completion >> ~/.bash_profile on OSX.
#
_opencode_yargs_completions()
{
    local cur_word args type_list

    cur_word="${COMP_WORDS[COMP_CWORD]}"
    args=("${COMP_WORDS[@]}")

    # ask yargs to generate completions.
    # see https://stackoverflow.com/a/40944195/7080036 for the spaces-handling awk
    mapfile -t type_list < <(opencode --get-yargs-completions "${args[@]}")
    mapfile -t COMPREPLY < <(compgen -W "$( printf '%q ' "${type_list[@]}" )" -- "${cur_word}" |
        awk '/ / { print "\""$0"\"" } /^[^ ]+$/ { print $0 }')

    # if no match was found, fall back to filename completion
    if [ ${#COMPREPLY[@]} -eq 0 ]; then
      COMPREPLY=()
    fi

    return 0
}
complete -o bashdefault -o default -F _opencode_yargs_completions opencode
###-end-opencode-completions-###

# Sourcing nvm.sh costs ~173ms, so load it on first use only. The node bin dir
# is already on PATH above, so node/npm/copilot/codex work without this firing.
export NVM_DIR="$HOME/.nvm"
nvm() {
	unset -f nvm
	# shellcheck disable=SC1091
	[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
	[ -s "$NVM_DIR/bash_completion" ] && . "$NVM_DIR/bash_completion"
	nvm "$@"
}

# Static equivalent of `brew shellenv` (~36ms), minus the subprocess.
if [ -d /home/linuxbrew/.linuxbrew ]; then
	export HOMEBREW_PREFIX="/home/linuxbrew/.linuxbrew"
	export HOMEBREW_CELLAR="/home/linuxbrew/.linuxbrew/Cellar"
	export HOMEBREW_REPOSITORY="/home/linuxbrew/.linuxbrew/Homebrew"
	export INFOPATH="/home/linuxbrew/.linuxbrew/share/info:${INFOPATH:-}"
	path_prepend "/home/linuxbrew/.linuxbrew/sbin"
	path_prepend "/home/linuxbrew/.linuxbrew/bin"
fi

# tf-reserve
[ -f ~/git/lxd-ci/bin/tf-reserve ] && . ~/git/lxd-ci/bin/tf-reserve

# ---------------------------------------------------------------- prompt

PROMPT_COMMAND='PS1_CMD1=$(git branch --show-current 2>/dev/null); if [ -n "$PS1_CMD1" ]; then PS1_CMD1=" [$PS1_CMD1]"; fi'

# Tokyo Night (night): user@host dark5, cwd blue, branch green1, time comment.
PS1='\[\e[38;2;115;122;162m\]\u@\h\[\e[0m\] \[\e[38;2;122;162;247m\]\w\[\e[0m\]\[\e[38;2;115;218;202m\]${PS1_CMD1}\[\e[0m\] \[\e[38;2;86;95;137m\]\@\[\e[0m\]\n\[\e[38;2;169;177;214m\]\$\[\e[0m\] '

# Set the terminal title. The stock Ubuntu block used to do this, but its PS1
# was overwritten above, so the title was being lost.
case "$TERM" in
xterm* | rxvt* | *-256color)
	PS1="\[\e]0;\u@\h: \w\a\]$PS1"
	;;
*) ;;
esac

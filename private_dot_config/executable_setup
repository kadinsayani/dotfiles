#!/usr/bin/env bash
#
# Bootstrap a new machine.
#
#   bash ~/.config/setup            # everything
#   bash ~/.config/setup core go    # only the named sections
#   DRY_RUN=1 bash ~/.config/setup  # print what would run, change nothing
#
# Idempotent: safe to re-run. Sections: core lxd go rust node desktop fonts repos dotfiles
#
set -euo pipefail

DRY_RUN="${DRY_RUN:-0}"
GIT_DIR="$HOME/git"
LXD_DEV_FORK="git@github.com:kadinsayani/lxd-dev.git"
LXD_DEV_UPSTREAM="git@github.com:canonical/lxd-dev.git"

case "$(uname -s)" in
  Linux)  OS=linux ;;
  Darwin) OS=macos ;;
  *) echo "unsupported OS: $(uname -s)" >&2; exit 1 ;;
esac

log()  { printf '\n\033[38;2;122;162;247m==>\033[0m \033[1m%s\033[0m\n' "$*"; }
info() { printf '    \033[38;2;115;122;162m%s\033[0m\n' "$*"; }
warn() { printf '    \033[38;2;224;175;104mwarn:\033[0m %s\n' "$*"; }
run()  {
  if [ "$DRY_RUN" = 1 ]; then printf '    \033[38;2;86;95;137m$ %s\033[0m\n' "$*"; else "$@"; fi
}
have() { command -v "$1" >/dev/null 2>&1; }

# ---------------------------------------------------------------- package mgr

APT_UPDATED=0
apt_install() {
  [ "$OS" = linux ] || return 0
  if [ "$APT_UPDATED" = 0 ]; then run sudo apt-get update -qq; APT_UPDATED=1; fi
  run sudo apt-get install -y --no-install-recommends "$@"
}

brew_install() {
  [ "$OS" = macos ] || return 0
  run brew install "$@"
}

snap_install() {  # snap_install <name> [--classic]
  [ "$OS" = linux ] || return 0
  local name="$1"; shift
  if snap list "$name" >/dev/null 2>&1; then info "snap $name already installed"; return 0; fi
  run sudo snap install "$name" "$@"
}

# Add an apt repo from a signing key URL + source line. Idempotent.
apt_repo() {  # apt_repo <name> <key-url> <source-line>
  [ "$OS" = linux ] || return 0
  local name="$1" key="$2" line="$3"
  local keyring="/etc/apt/keyrings/${name}.gpg"
  local list="/etc/apt/sources.list.d/${name}.list"
  [ -f "$list" ] && { info "repo $name already configured"; return 0; }
  run sudo install -d -m 0755 /etc/apt/keyrings
  if [ "$DRY_RUN" = 1 ]; then
    info "\$ curl -fsSL $key | sudo gpg --dearmor -o $keyring"
    info "\$ echo '$line' | sudo tee $list"
  else
    curl -fsSL "$key" | sudo gpg --dearmor -o "$keyring"
    sudo chmod 0644 "$keyring"
    echo "$line" | sudo tee "$list" >/dev/null
  fi
  APT_UPDATED=0
}

# ---------------------------------------------------------------- sections

section_core() {
  log "Core CLI + dev tools"
  if [ "$OS" = linux ]; then
    apt_install \
      build-essential git curl wget ca-certificates gnupg unzip xz-utils \
      jq tree htop tmux rsync socat netcat-openbsd whois bind9-dnsutils \
      ripgrep fd-find git-delta shellcheck hyperfine pandoc fzf bat \
      python3 python3-venv python3-pynvim python3-yaml \
      gettext-base libsecret-tools \
      xclip wl-clipboard asciinema

    # just MUST come from apt, not snap: lxd-dev's `just setup-keyring` needs D-Bus
    # secret-service access, which snap confinement blocks. See lxd-dev/README.md.
    apt_install just

    # gh is not in the Ubuntu archive.
    apt_repo github-cli https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/github-cli.gpg] https://cli.github.com/packages stable main"
    apt_install gh

    snap_install nvim --classic
    snap_install helix --classic
    snap_install yq
    snap_install chezmoi --classic

    # Ubuntu ships fd as fdfind and delta as git-delta; alias in .bashrc if wanted.
    have fdfind && ! have fd && info "fd is installed as 'fdfind' on Ubuntu"
  else
    have brew || run /bin/bash -c \
      "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    brew_install git curl wget jq tree htop tmux rsync socat \
      ripgrep fd git-delta shellcheck hyperfine just pandoc fzf bat \
      python3 gh neovim helix yq chezmoi asciinema
  fi
}

section_lxd() {
  if [ "$OS" != linux ]; then
    warn "skipping LXD stack: Linux only"
    return 0
  fi
  log "LXD / Canonical work stack"

  # Build dependencies for lxd + dqlite + go-lxc.
  apt_install \
    autoconf automake libtool pkg-config meson ninja-build cmake gettext \
    libacl1-dev libapparmor-dev libcap-dev libdbus-1-dev liblxc-dev \
    liblz4-dev libseccomp-dev libsqlite3-dev libudev-dev libuv1-dev \
    libfuse3-dev fuse3

  # Storage backends.
  apt_install \
    acl attr btrfs-progs zfsutils-linux lvm2 thin-provisioning-tools \
    xfsprogs xfslibs-dev dosfstools gdisk e2fsprogs bcache-tools \
    squashfs-tools squashfs-tools-ng ceph-common

  # Networking.
  apt_install \
    nftables ebtables iproute2 dnsmasq-base openvswitch-switch ovn-host ovn-central

  # VM / image tooling.
  apt_install \
    qemu-system-x86 qemu-utils qemu-block-extra qemu-user-static \
    virtiofsd swtpm busybox-static umoci expect s3cmd

  # This machine tracks latest/edge; lxd-dev's README asks for --channel=6/candidate.
  snap_install lxd --channel=latest/edge
  snap_install snapcraft --classic
  snap_install rockcraft --classic
  # The container layer the whole lxd-dev workflow runs inside.
  snap_install workshop --classic

  if ! getent group lxd | grep -w "$USER" >/dev/null; then
    run sudo usermod -aG lxd "$USER"
    warn "added $USER to the lxd group — log out and back in for it to take effect"
  fi
}

section_go() {
  log "Go toolchain + tools"
  if [ "$OS" = linux ]; then snap_install go --classic; else brew_install go; fi
  have go || { warn "go not on PATH yet; skipping go tools"; return 0; }

  local tools=(
    golang.org/x/tools/gopls@latest
    github.com/go-delve/delve/cmd/dlv@latest
    github.com/golangci/golangci-lint/v2/cmd/golangci-lint@latest
    honnef.co/go/tools/cmd/staticcheck@latest
    mvdan.cc/sh/v3/cmd/shfmt@latest
    golang.org/x/tools/cmd/goimports@latest
    github.com/daixiang0/gci@latest
    github.com/jesseduffield/lazygit@latest
    github.com/charmbracelet/glow@latest
  )
  local t
  for t in "${tools[@]}"; do
    info "go install ${t}"
    run go install "$t"
  done
}

section_rust() {
  log "Rust toolchain"
  if [ "$OS" = linux ]; then
    snap_install rustup --classic
  else
    brew_install rustup
  fi
  have rustup && run rustup default stable

  # zellij has no snap/apt package; it comes from crates.io.
  if have cargo && ! have zellij; then
    run cargo install zellij
  else
    info "zellij already installed (or cargo not on PATH yet)"
  fi
}

section_node() {
  log "Node + agent CLIs"
  if [ "$OS" = linux ]; then apt_install nodejs npm; else brew_install node; fi
  have npm || { warn "npm not on PATH; skipping global installs"; return 0; }
  run npm install -g @github/copilot @openai/codex opencode-ai

  # Claude Code is not on npm; it installs into ~/.local/share/claude and
  # symlinks ~/.local/bin/claude.
  if have claude; then
    info "claude already installed ($(claude --version 2>/dev/null || echo present))"
  elif [ "$DRY_RUN" = 1 ]; then
    info "\$ curl -fsSL https://claude.ai/install.sh | bash"
  else
    curl -fsSL https://claude.ai/install.sh | bash
  fi
  case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) warn "add \$HOME/.local/bin to PATH for the claude binary" ;;
  esac
}

section_desktop() {
  log "Desktop apps"
  if [ "$OS" = linux ]; then
    snap_install code --classic
    snap_install ghostty --classic
    snap_install mattermost-desktop

    apt_repo google-chrome https://dl.google.com/linux/linux_signing_key.pub \
      "deb [arch=amd64 signed-by=/etc/apt/keyrings/google-chrome.gpg] https://dl.google.com/linux/chrome/deb/ stable main"
    apt_install google-chrome-stable

    local codename; codename="$(. /etc/os-release && echo "$VERSION_CODENAME")"
    apt_repo tailscale "https://pkgs.tailscale.com/stable/ubuntu/${codename}.noarmor.gpg" \
      "deb [signed-by=/etc/apt/keyrings/tailscale.gpg] https://pkgs.tailscale.com/stable/ubuntu ${codename} main"
    apt_install tailscale
    info "run 'sudo tailscale up' to authenticate"

    # ProxyCommand for Host *.canonical.is in ~/.ssh/config.
    snap_install charmed-cloudflared
    # Needed by the id_ed25519_sk (FIDO) key.
    apt_install yubikey-manager yubikey-personalization
  else
    run brew install --cask visual-studio-code google-chrome ghostty mattermost tailscale
  fi
}

section_fonts() {
  log "Fonts (UbuntuMono Nerd Font)"
  local dir ver url
  if [ "$OS" = macos ]; then
    run brew install --cask font-ubuntu-mono-nerd-font
    return 0
  fi
  dir="$HOME/.local/share/fonts"
  if fc-list 2>/dev/null | grep -i "UbuntuMono Nerd Font" >/dev/null; then
    info "UbuntuMono Nerd Font already installed"
    return 0
  fi
  ver="v3.2.1"
  url="https://github.com/ryanoasis/nerd-fonts/releases/download/${ver}/UbuntuMono.zip"
  run mkdir -p "$dir"
  if [ "$DRY_RUN" = 1 ]; then
    info "\$ curl -fsSL $url | bsdtar -xf- -C $dir"
  else
    local tmp; tmp="$(mktemp -d)"
    curl -fsSL "$url" -o "$tmp/UbuntuMono.zip"
    unzip -qo "$tmp/UbuntuMono.zip" -d "$dir"
    rm -rf "$tmp"
    fc-cache -f "$dir" >/dev/null
  fi
}

section_ssh() {
  log "SSH keys + agent"
  local key="$HOME/.ssh/id_ed25519"

  run mkdir -p "$HOME/.ssh"
  [ "$DRY_RUN" = 1 ] || chmod 700 "$HOME/.ssh"

  if [ -f "$key" ]; then
    info "$key already exists — leaving it alone"
  elif [ "$DRY_RUN" = 1 ]; then
    info "\$ ssh-keygen -t ed25519 -C \"$(git config --global user.email 2>/dev/null)\" -f $key"
  else
    ssh-keygen -t ed25519 -C "$(git config --global user.email 2>/dev/null || echo "$USER@$(hostname)")" -f "$key" -N ""
    chmod 600 "$key"
  fi

  # Pre-seed github.com so the first clone does not stop on a host-key prompt.
  if [ "$DRY_RUN" = 1 ]; then
    info "\$ ssh-keyscan github.com >> ~/.ssh/known_hosts"
  elif ! ssh-keygen -F github.com >/dev/null 2>&1; then
    ssh-keyscan -t rsa,ecdsa,ed25519 github.com >> "$HOME/.ssh/known_hosts" 2>/dev/null
    info "added github.com to known_hosts"
  else
    info "github.com already in known_hosts"
  fi

  if [ "$DRY_RUN" = 1 ]; then
    info "\$ eval \$(ssh-agent -s) && ssh-add $key"
  else
    [ -n "${SSH_AUTH_SOCK:-}" ] || eval "$(ssh-agent -s)" >/dev/null
    ssh-add "$key" 2>/dev/null || warn "could not ssh-add $key"
  fi

  if [ -f "${key}.pub" ] && [ "$DRY_RUN" != 1 ]; then
    if have gh && gh auth status >/dev/null 2>&1; then
      info "gh is authenticated; upload with: gh ssh-key add ${key}.pub"
    else
      printf '\n'
      info "add this key to GitHub (https://github.com/settings/keys):"
      printf '    %s\n\n' "$(cat "${key}.pub")"
      info "the 'repos' and 'lxddev' sections clone over SSH and need it"
    fi
  fi
}

section_lxddev() {
  if [ "$OS" != linux ]; then
    warn "skipping lxd-dev: Linux only (Workshop snap requires Ubuntu)"
    return 0
  fi
  log "lxd-dev prerequisites"

  # Required before any `just` recipe runs: jq is read at Justfile parse time,
  # secret-tool backs the token keyring, PyYAML drives generate-workshop-config,
  # envsubst renders the VM cloud-init.
  apt_install jq libsecret-tools python3-yaml gettext-base rsync openssh-client

  if ! have just; then
    warn "just is missing — run the 'core' section first (apt, not snap)"
  elif have just && [ "$(command -v just)" != "/usr/bin/just" ]; then
    warn "just is not the apt build ($(command -v just)); keyring setup will fail"
  else
    info "just is the apt build"
  fi

  snap_install workshop --classic

  local repo="$GIT_DIR/lxd-dev"
  if [ ! -d "$repo/.git" ]; then
    warn "lxd-dev not cloned yet — run the 'repos' section first"
    return 0
  fi

  info "remaining steps are interactive and must be run by hand, in $repo:"
  info "  just install-tools"
  info "  # confirm config/$USER/config.json has your handle/email/repos"
  info "  just setup       # prompts for Copilot + gh tokens via secret-tool"
  info "see $repo/README.md"
}

section_repos() {
  log "Repositories"
  run mkdir -p "$GIT_DIR"
  local dest="$GIT_DIR/lxd-dev"
  if [ -d "$dest/.git" ]; then
    info "lxd-dev already cloned at $dest"
  else
    run git clone "$LXD_DEV_FORK" "$dest"
  fi
  if [ "$DRY_RUN" = 1 ]; then
    info "\$ git -C $dest remote add upstream $LXD_DEV_UPSTREAM"
  elif ! git -C "$dest" remote | grep -x upstream >/dev/null; then
    git -C "$dest" remote add upstream "$LXD_DEV_UPSTREAM"
    info "added upstream remote"
  else
    info "upstream remote already present"
  fi
}

section_dotfiles() {
  log "Dotfiles"
  if ! have chezmoi; then
    warn "chezmoi not installed; run the 'core' section first"
    return 0
  fi
  if [ -d "$HOME/.local/share/chezmoi/.git" ]; then
    info "chezmoi source already initialised"
  else
    run chezmoi init --apply git@github.com:kadinsayani/dotfiles.git
  fi
  # autoCommit/autoPush are not in the dotfiles repo; recreate them here.
  local cfg="$HOME/.config/chezmoi/chezmoi.toml"
  if [ -f "$cfg" ]; then
    info "chezmoi.toml already present"
  else
    run mkdir -p "$(dirname "$cfg")"
    if [ "$DRY_RUN" = 1 ]; then
      info "\$ write $cfg (git.autoCommit/autoPush)"
    else
      printf '[git]\nautoCommit = true\nautoPush = true\n' > "$cfg"
    fi
  fi
}

# ---------------------------------------------------------------- doctor

DOCTOR_FAIL=0
DOCTOR_WARN=0

d_ok()   { printf '    \033[38;2;115;218;202mPASS\033[0m  %s\n' "$*"; }
d_bad()  { printf '    \033[38;2;247;118;142mFAIL\033[0m  %s\n' "$*"; DOCTOR_FAIL=$((DOCTOR_FAIL+1)); }
d_warn() { printf '    \033[38;2;224;175;104mWARN\033[0m  %s\n' "$*"; DOCTOR_WARN=$((DOCTOR_WARN+1)); }

# d_cmd <binary> [note] — FAIL if the binary is not on PATH.
d_cmd() {
  if have "$1"; then d_ok "$1"; else d_bad "$1 not on PATH${2:+ ($2)}"; fi
}

# d_cmd_opt <binary> [note] — WARN instead of FAIL; for things that are nice to have.
d_cmd_opt() {
  if have "$1"; then d_ok "$1"; else d_warn "$1 not on PATH${2:+ ($2)}"; fi
}

section_doctor() {
  log "Doctor — verifying, changing nothing"

  info "core tools"
  local c
  for c in git curl jq tree htop tmux rg shellcheck chezmoi; do d_cmd "$c"; done
  have fd || have fdfind && d_ok "fd (as $(command -v fd 2>/dev/null || command -v fdfind))" || d_bad "fd/fdfind"
  d_cmd_opt bat
  d_cmd_opt fzf
  d_cmd_opt delta "git-delta; lazygit pager"

  info "editors + multiplexers"
  d_cmd nvim
  d_cmd_opt hx "helix"
  d_cmd_opt zellij

  info "languages"
  d_cmd go
  d_cmd_opt cargo "rustup default stable"
  d_cmd python3

  info "agent CLIs"
  d_cmd_opt claude
  d_cmd_opt copilot
  d_cmd_opt codex
  d_cmd_opt opencode

  if [ "$OS" = linux ]; then
    info "lxd-dev stack"
    d_cmd lxc
    d_cmd_opt workshop
    d_cmd secret-tool "libsecret-tools; needed by just setup-keyring"
    d_cmd envsubst "gettext-base"
    if have just; then
      if [ "$(command -v just)" = /usr/bin/just ]; then
        d_ok "just (apt build)"
      else
        d_bad "just is $(command -v just), not /usr/bin/just — keyring setup will fail"
      fi
    else
      d_bad "just not on PATH"
    fi
    if python3 -c 'import yaml' 2>/dev/null; then
      d_ok "python3 PyYAML"
    else
      d_bad "python3 PyYAML missing — generate-workshop-config will fail"
    fi
    if id -nG 2>/dev/null | grep -w lxd >/dev/null; then
      d_ok "lxd group applied to this session"
    elif getent group lxd 2>/dev/null | grep -w "$USER" >/dev/null; then
      d_warn "in the lxd group, but this session predates it — log out and back in"
    else
      d_bad "$USER is not in the lxd group"
    fi
  fi

  info "ssh + git identity"
  if [ -f "$HOME/.ssh/id_ed25519" ]; then d_ok "ssh key id_ed25519"; else d_bad "no id_ed25519 in .ssh"; fi
  if [ -n "${SSH_AUTH_SOCK:-}" ]; then d_ok "ssh-agent running"; else d_warn "no ssh-agent in this session"; fi
  if ssh-keygen -F github.com >/dev/null 2>&1; then
    d_ok "github.com in known_hosts"
  else
    d_warn "github.com not in known_hosts — first clone will prompt"
  fi
  local ssh_out
  ssh_out="$(ssh -o BatchMode=yes -o ConnectTimeout=5 -T git@github.com 2>&1 || true)"
  case "$ssh_out" in
    *"successfully authenticated"*) d_ok "github.com SSH auth" ;;
    *) d_warn "github.com SSH auth failed — add ~/.ssh/id_ed25519.pub to GitHub" ;;
  esac
  if [ -f "$HOME/.ssh/allowed_signers" ]; then
    d_ok "allowed_signers"
  else
    d_warn "no allowed_signers — git cannot verify your own signatures"
  fi

  info "theming"
  if have bat && bat --list-themes 2>/dev/null | grep -q tokyonight_night; then
    d_ok "bat tokyonight_night theme (run 'bat cache --build' if it drops out)"
  else
    d_warn "bat tokyonight_night theme not registered"
  fi
  if [ "$OS" = linux ] && fc-list 2>/dev/null | grep -i "UbuntuMono Nerd Font" >/dev/null; then
    d_ok "UbuntuMono Nerd Font"
  elif [ "$OS" = linux ]; then
    d_warn "UbuntuMono Nerd Font missing — glyphs will be wrong"
  fi

  info "dotfiles"
  if have chezmoi; then
    if [ -z "$(chezmoi status 2>/dev/null)" ]; then
      d_ok "chezmoi status clean"
    else
      d_warn "chezmoi has unapplied changes — run 'chezmoi diff'"
    fi
  fi
  if [ -d "$GIT_DIR/lxd-dev/.git" ]; then
    d_ok "lxd-dev cloned"
    if [ -f "$GIT_DIR/lxd-dev/config/$USER/config.json" ]; then
      d_ok "lxd-dev config/$USER/config.json"
    else
      d_warn "no lxd-dev config/$USER/config.json — 'just setup' needs it"
    fi
  else
    d_warn "lxd-dev not cloned"
  fi

  printf '\n'
  if [ "$DOCTOR_FAIL" -eq 0 ] && [ "$DOCTOR_WARN" -eq 0 ]; then
    info "all checks passed"
  else
    info "$DOCTOR_FAIL failed, $DOCTOR_WARN warnings"
  fi
}

# ---------------------------------------------------------------- main

ALL_SECTIONS=(core lxd go rust node desktop fonts ssh repos lxddev dotfiles doctor)

main() {
  local sections=("$@")
  [ ${#sections[@]} -eq 0 ] && sections=("${ALL_SECTIONS[@]}")

  [ "$DRY_RUN" = 1 ] && log "DRY RUN — nothing will be changed"
  info "detected OS: $OS"

  local s
  for s in "${sections[@]}"; do
    if ! printf '%s\n' "${ALL_SECTIONS[@]}" | grep -x "$s" >/dev/null; then
      echo "unknown section: $s (valid: ${ALL_SECTIONS[*]})" >&2
      exit 1
    fi
  done
  for s in "${sections[@]}"; do "section_${s}"; done

  if [ "$DOCTOR_FAIL" -gt 0 ]; then
    log "Done — with $DOCTOR_FAIL failed check(s)"
    return 1
  fi

  log "Done"
  info "remaining manual steps:"
  info "  - authenticate: gh auth login, sudo tailscale up"
  info "  - add your SSH key to GitHub before the 'repos' section"
  info "  - log out/in for the lxd group to apply"
}

main "$@"
